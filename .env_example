# alert-agent 环境变量示例
# 使用：cp .env_example .env 后填入真实值；.env 已 gitignore，勿提交
# 凭证在 config.yaml 中以 ${ENV_VAR} 引用，亦可直接注入进程环境

# ---- LLM：排查主力（大模型，需 function calling） ----
LLM_REASONER_BASE_URL=https://api.siliconflow.cn/v1
LLM_REASONER_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_REASONER_API_KEY=sk-xxx

# ---- LLM：语义路由小模型（可选，规则路由未命中时兜底） ----
LLM_ROUTER_BASE_URL=https://api.siliconflow.cn/v1
LLM_ROUTER_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_ROUTER_API_KEY=sk-xxx

# ---- 飞书自建应用（卡片通知 + 长连接双向闭环） ----
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_CHAT_ID=oc_xxx

# ---- 运维 CLI 凭证（可选，exec 工具沙箱注入，config.yaml tools.exec.docker.env 引用） ----
# OPS_CLI_TOKEN=xxx   # 沙箱 CLI 凭证示例——按业务实际变量名命名（config 的 docker.env 引用此处）
